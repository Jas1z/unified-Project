# Copy to backend/.env and fill in values (Docker loads backend/.env, NOT this file).
MONGODB_URL=mongodb://localhost:27017/ehrdb
JWT_SECRET=change-me-for-local-dev

# From https://aistudio.google.com/apikey — AIza… (legacy) or AQ.… (new) formats both work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
