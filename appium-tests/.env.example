# Appium Server Configuration
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_TIMEOUT=30000

# Android Device Configuration
ANDROID_DEVICE_NAME=emulator-5554
ANDROID_PLATFORM_VERSION=14
ANDROID_PLATFORM_NAME=Android
ANDROID_APP_PACKAGE=com.anonymous.ehrmobile
ANDROID_APP_ACTIVITY=.MainActivity
ANDROID_AUTOMATION_NAME=UiAutomator2

# APK Path
APK_PATH=../ehr-mobile/android/app/build/outputs/apk/release/app-release.apk

# Test Configuration
TEST_TIMEOUT=30000
IMPLICIT_WAIT=10000
SCREENSHOT_ON_FAILURE=true
GENERATE_EXCEL_REPORT=true

# Web Interface Configuration
WEB_APP_URL=http://10.0.2.2:5173

# Report Configuration
REPORT_OUTPUT_PATH=./reports
REPORT_FILENAME=ehr-mobile-test-report
